{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "rust",
  "include-component-in-tag": true,
  "bump-minor-pre-major": true,
  "bootstrap-sha": "901fd1d0ea2f602fe96e520f806a560d191bda09",
  "plugins": ["cargo-workspace"],
  "packages": {
    "crates/math": { "component": "spatial-math" },
    "crates/field": { "component": "analytic-field" },
    "crates/world": { "component": "world-state" },
    "crates/simulation": { "component": "world-simulation" },
    "crates/runtime": { "component": "world-runtime" },
    "crates/renderer": { "component": "analytic-renderer" },
    "crates/authoring": { "component": "world-authoring" },
    "examples/hello-world": {
      "component": "hello-world",
      "exclude-paths": ["examples/hello-world"],
      "skip-github-release": true
    },
    "examples/first-light": {
      "component": "first-light",
      "exclude-paths": ["examples/first-light"],
      "skip-github-release": true
    },
    "examples/first-life": {
      "component": "first-life",
      "exclude-paths": ["examples/first-life"],
      "skip-github-release": true
    }
  }
}
